         else
             break
         end
     end
 
-    error("Task failed after " .. self.config.maxRetries .. " retries: " .. tostring(lastError))
+    error("Task failed after " .. self.retryPolicy.maxRetries .. " retries: " .. tostring(lastError) .. " (budget: " .. self.currentBudget.toolCalls .. " tool calls)")
 end
 
